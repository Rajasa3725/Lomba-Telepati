e_smut\",\n","            \"Healthy Rice Leaf\": \"healthy\",\n","            \"Healthy Rice beads\": \"healthy\",\n","            \"Healthy\": \"healthy\",\n","            \"healthy\": \"healthy\",\n","            \"Leaf-roller\": \"leaf_roller\",\n","            \"Leaf Scald\": \"leaf_scald\",\n","            \"Leaf scald\": \"leaf_scald\",\n","            \"Narrow brown\": \"narrow_brown\",\n","            \"Sheath Blight\": \"sheath_blight\",\n","            \"Rice-Tungro\": \"tungro\",\n","        }\n","    )\n","    class_names: List[str] = field(\n","        default_factory=lambda: [\n","            \"bacterial_leaf_blight\",\n","            \"bacterial_panicle_blight\",\n","            \"blast\",\n","            \"brown_spot\",\n","            \"false_smut\",\n","            \"healthy\",\n","            \"leaf_roller\",\n","            \"leaf_scald\",\n","            \"narrow_brown\",\n","            \"sheath_blight\",\n","            \"tungro\",\n","        ]\n","    )\n","\n","    # --- Hyperparameter training YOLO26m ---\n","    model_yaml= \"yolo26s.yaml\"\n","    train_epochs = 200\n","    train_batch = 32\n","    train_imgsz = 640\n","    train_save_period = 50\n","    train_pretrained = False\n","    train_hsv_h = 0.01\n","    train_hsv_s= 0.3\n","    train_hsv_v = 0.3\n","    train_translate= 0.2\n","    train_shear = 0\n","    train_perspective = 0\n","    train_scale = 0.4\n","    train_degrees = 0\n","    train_fliplr = 0.3\n","    train_flipud = 0.3\n","    train_mosaic = 0.4\n","    train_close_mosaic = 10\n","    train_erasing = 0.1\n","    train_auto_augment = None\n","    train_cos_lr = False\n","    train_patience = 0\n","    train_device=[0,1]\n","    train_project = Path(r\"kaggle/working/train\")\n","    train_name = \"train_yolo26s\"\n","\n","    @property\n","    def class_to_id(self) -> Dict[str, int]:\n","        return {name: i for i, name in enumerate(self.class_names)}\n","\n","    @property\n","    def best_weights_path(self) -> str:\n","        return str(\"/kaggle/working/runs/detect/kaggle/working/train/train_yolo26s/weights/best.pt\")\n","\n","\n","CFG = Config()\n","\n","\n","def set_seed(seed: int) -> None:\n","    random.seed(seed)\n","    np.random.seed(seed)\n","\n","\n","set_seed(CFG.seed)"]},{"cell_type":"code","execution_count":6,"id":"0ccd5054","metadata":{"execution":{"iopub.execute_input":"2026-09-26T08:13:55.94608Z","iopub.status.busy":"2026-09-26T08:13:55.945273Z","iopub.status.idle":"2026-09-26T08:13:55.951611Z","shell.execute_reply":"2026-09-26T08:13:55.950701Z"},"id":"314a5004","outputId":"8055c3bc-314c-4a1c-9f3e-e9a7ddc5c85a","papermill":{"duration":0.063743,"end_time":"2026-09-26T08:13:55.953212+00:00","exception":false,"start_time":"2026-09-26T08:13:55.889469+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[train]\n","Folder : /kaggle/working/dataset/Telepati 8.0 Datasets/train\n","JSON   : /kaggle/working/dataset/Telepati 8.0 Datasets/train/_annotations.coco.json\n","JSON exists : True\n","\n","[valid]\n","Folder : /kaggle/working/dataset/Telepati 8.0 Datasets/valid\n","JSON   : /kaggle/working/dataset/Telepati 8.0 Datasets/valid/_annotations.coco.json\n","JSON exists : True\n","\n","[test]\n","Folder : /kaggle/working/dataset/Telepati 8.0 Datasets/test\n","JSON   : /kaggle/working/dataset/Telepati 8.0 Datasets/test/_annotations.coco.json\n","JSON exists : True\n"]}],"source":["def check_dataset_structure(cfg: Config) -> None:\n","    for split in cfg.coco_splits:\n","        split_dir = cfg.dataset_root / split\n","        json_path = split_dir / cfg.coco_annotation_file\n","\n","        print(f\"\\n[{split}]\")\n","        print(\"Folder :\", split_dir)\n","        print(\"JSON   :\", json_path)\n","        print(\"JSON exists :\", json_path.exists())\n","\n","\n","check_dataset_structure(CFG)"]},{"cell_type":"code","execution_count":7,"id":"867e4868","metadata":{"execution":{"iopub.execute_input":"2026-09-26T